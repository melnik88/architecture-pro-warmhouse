@startuml
' Сущности
entity "User" as user {
  * user_id : UUID <<PK>>
  --
  username : VARCHAR(255)
  created_at : TIMESTAMP
}

entity "Session" as session {
  * session_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  created_at : TIMESTAMP
  expires_at : TIMESTAMP
}

entity "Home" as home {
  * home_id : UUID <<PK>>
  --
  * owner_id : UUID <<FK>>
  home_name : VARCHAR(255)
  address : TEXT
  created_at : TIMESTAMP
}

entity "Device" as device {
  * device_id : UUID <<PK>>
  --
  * home_id : UUID <<FK>>
  device_name : VARCHAR(255)
  device_type : VARCHAR(100)
  is_active : BOOLEAN
  configuration : JSONB
  created_at : TIMESTAMP
}

entity "Telemetry" as telemetry {
  * telemetry_id : UUID <<PK>>
  --
  * device_id : UUID <<FK>>
  telemetry_data : JSONB
}

entity "Scenario" as scenario {
  * scenario_id : UUID <<PK>>
  --
  * home_id : UUID <<FK>>
  scenario_title : VARCHAR(255)
  actions : JSONB
  is_active : BOOLEAN
  created_at : TIMESTAMP
}

entity "DeviceScenario" as device_scenario {
  * device_scenario_id : UUID <<PK>>
  --
  * device_id : UUID <<FK>>
  * scenario_id : UUID <<FK>>
  created_at : TIMESTAMP
}

' Связи
user ||--o{ session : "имеет"
user ||--o{ home : "владеет"

home ||--o{ device : "содержит"
home ||--o{ scenario : "включает"

device ||--|| telemetry : "генерирует"
device ||--o{ device_scenario : "участвует в"
scenario ||--o{ device_scenario : "включает"

@enduml
